[Unit]
Description=Predico 50Hertz: archivo diario de ENTSO-E (F2.7)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=1h
StartLimitBurst=4
OnFailure=predico-failure@%n.service

[Service]
Type=oneshot
WorkingDirectory=@REPO@
EnvironmentFile=-%h/.config/predico/ops.env
ExecStartPre=@REPO@/.venv/bin/python -m predico50hz.orchestration wait-online --for entsoe-daily --timeout-s 600
ExecStart=@REPO@/.venv/bin/python -m predico50hz.orchestration entsoe-daily
TimeoutStartSec=1h
Restart=on-failure
RestartSec=5min
Nice=10
