[Unit]
Description=Predico 50Hertz: pasada NWP 00Z diaria (F1.5)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=6h
StartLimitBurst=4
OnFailure=predico-failure@%n.service

[Service]
Type=oneshot
WorkingDirectory=@REPO@
EnvironmentFile=-%h/.config/predico/ops.env
ExecStartPre=@REPO@/.venv/bin/python -m predico50hz.orchestration wait-online --for nwp-daily --timeout-s 600
ExecStart=@REPO@/.venv/bin/python -m predico50hz.orchestration nwp-daily
TimeoutStartSec=5h
Restart=on-failure
RestartSec=10min
Nice=10
