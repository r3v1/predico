# Variables de entorno de Predico 50Hertz. Copiar a .env (que no va a git) y rellenar.
# Las claves de ENTSO-E, ECMWF y rutas del NAS se añadirán aquí cuando hagan falta.

# ENTSO-E Transparency Platform (F2): token personal de la API REST.
ENTSOE_API_KEY=

# Operación diaria (src/predico50hz/orchestration/settings.py). Todas opcionales; abajo, los
# valores por defecto del equipo de sobremesa. En Docker se fijan en docker/compose.yaml.
# PREDICO_DATA_DIR=data
# PREDICO_NWP_BRONZE=/mnt/data/nwp/IFS-ENS/icechunk
# PREDICO_CENTROIDS=config/centroids.yaml
# PREDICO_LOCK_DIR=data/ops/locks
# PREDICO_POLL_INTERVAL_S=300
# PREDICO_POLL_DEADLINE_UTC=12:00
